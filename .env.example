# Copy to .env.local. Every value is optional — the site runs fully without them.

# Canonical origin, used by sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.luxuryrealestate.com

# Matterport Showcase model id. When set, listings with a Matterport tour gain a
# "Matterport" tab in the viewer alongside the built-in 360 engine. Leave blank
# and the built-in engine is the only provider offered.
NEXT_PUBLIC_MATTERPORT_MODEL_ID=

# Google Maps Embed API key. Enables the Street View tab in the tour viewer and
# on the property detail page. Without it, that tab links out to Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
